{
  "manifest_version": 3,
  "name": "Job Clipper — 1-Click Internship & Job Tracker",
  "version": "1.0.0",
  "description": "Clip job postings from any website into a drag-and-drop Kanban board with deadline reminders and CSV export.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Clipper"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
