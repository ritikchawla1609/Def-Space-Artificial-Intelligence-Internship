{
  "manifest_version": 3,
  "name": "Circle to Fix — AI Bug Reporter",
  "version": "1.0.0",
  "description": "Circle a UI problem on any page and get a ready-to-paste prompt for your coding agent with code snippet and screenshot.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "commands": {
    "activate-circle-to-fix": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Activate Circle to Fix Drawing Overlay"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Circle to Fix"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/html2canvas.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
